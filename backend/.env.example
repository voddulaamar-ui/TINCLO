# MongoDB Atlas Connection String
# Use SRV format for production (Render/cloud):
MONGODB_URI=mongodb+srv://tinclo_amar:<db_password>@cluster0.ulyvnj2.mongodb.net/job-swipe-matcher?retryWrites=true&w=majority&appName=Cluster0
# If SRV is blocked locally, use direct format:
# MONGODB_URI=mongodb://tinclo_amar:<db_password>@ac-8gbjw80-shard-00-00.ulyvnj2.mongodb.net:27017,ac-8gbjw80-shard-00-01.ulyvnj2.mongodb.net:27017,ac-8gbjw80-shard-00-02.ulyvnj2.mongodb.net:27017/job-swipe-matcher?ssl=true&replicaSet=atlas-5mq3wi-shard-0&authSource=admin&retryWrites=true&w=majority

# Server Port
PORT=5002

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# JSearch API Key (RapidAPI) - optional, uses mock jobs if empty
JSEARCH_API_KEY=

# Email Configuration (Gmail SMTP)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
